<% layout("/layouts/boilerplate") %>

<main class="explore-page py-4 py-lg-5">
  <header class="explore-page-heading">
    <p>Find your next stay</p>
    <h1>Explore unique places</h1>
    <span>Discover homes, rooms, nature escapes, and more.</span>
  </header>

  <section class="explore-toolbar" aria-label="Listing filters">
    <div class="listing-filters">
      <a href="/listings" class="filter <%= !category ? 'filter-active' : '' %>">
        <i class="fa-solid fa-hotel"></i><span>All stays</span>
      </a>
      <a href="/listings?category=trending" class="filter <%= category === 'trending' ? 'filter-active' : '' %>">
        <i class="fa-solid fa-fire"></i><span>Trending</span>
      </a>
      <a href="/listings?category=rooms" class="filter <%= category === 'rooms' ? 'filter-active' : '' %>">
        <i class="fa-solid fa-bed"></i><span>Rooms</span>
      </a>
      <a href="/listings?category=iconic-cities" class="filter <%= category === 'iconic-cities' ? 'filter-active' : '' %>">
        <i class="fa-solid fa-mountain-city"></i><span>Iconic cities</span>
      </a>
      <a href="/listings?category=mountains" class="filter <%= category === 'mountains' ? 'filter-active' : '' %>">
        <i class="fa-solid fa-mountain"></i><span>Mountains</span>
      </a>
      <a href="/listings?category=castles" class="filter <%= category === 'castles' ? 'filter-active' : '' %>">
        <i class="fa-brands fa-fort-awesome"></i><span>Castles</span>
      </a>
      <a href="/listings?category=amazing-pools" class="filter <%= category === 'amazing-pools' ? 'filter-active' : '' %>">
        <i class="fa-solid fa-person-swimming"></i><span>Pools</span>
      </a>
      <a href="/listings?category=farms" class="filter <%= category === 'farms' ? 'filter-active' : '' %>">
        <i class="fa-solid fa-tractor"></i><span>Farms</span>
      </a>
      <a href="/listings?category=camping" class="filter <%= category === 'camping' ? 'filter-active' : '' %>">
        <i class="fa-solid fa-campground"></i><span>Camping</span>
      </a>
      <a href="/listings?category=arctic" class="filter <%= category === 'arctic' ? 'filter-active' : '' %>">
        <i class="fa-solid fa-snowflake"></i><span>Arctic</span>
      </a>
      <a href="/listings?category=beaches" class="filter <%= category === 'beaches' ? 'filter-active' : '' %>">
        <i class="fa-solid fa-umbrella-beach"></i><span>Beaches</span>
      </a>
      <a href="/listings?category=domes" class="filter <%= category === 'domes' ? 'filter-active' : '' %>">
        <i class="fa-solid fa-igloo"></i><span>Domes</span>
      </a>
    </div>

    <label class="tax-toggle" for="switchCheckDefault">
      <span>Show tax</span>
      <span class="form-check form-switch m-0">
        <input class="form-check-input m-0" type="checkbox" role="switch" id="switchCheckDefault">
      </span>
    </label>
  </section>

  <% if(allListings.length > 0) { %>
    <div class="row g-4 listing-grid">
      <% for(let listing of allListings) { %>
        <div class="col-12 col-sm-6 col-lg-4 col-xxl-3">
          <a href="/listings/<%= listing._id %>" class="listing-link">
            <article class="listing-card home-listing-card h-100">
              <div class="home-listing-image-wrap">
                <img class="home-listing-image" src="<%= listing.image.url %>" alt="<%= listing.title %>">
                <span class="home-listing-category"><%= listing.category %></span>
              </div>
              <div class="home-listing-content">
                <h2><%= listing.title %></h2>
                <p><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></p>
                <div class="home-listing-price">
                  <strong>₹<%= listing.price.toLocaleString("en-IN") %></strong><span> / night</span>
                  <small class="tax-info">+18% GST</small>
                </div>
              </div>
            </article>
          </a>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <div class="explore-empty-state">
      <i class="fa-regular fa-compass"></i>
      <h2>No stays found</h2>
      <p>Try another category or view all available stays.</p>
      <a href="/listings" class="btn btn-danger">View all stays</a>
    </div>
  <% } %>
</main>

<script>
  const taxSwitch = document.getElementById("switchCheckDefault");
  const taxInfo = document.querySelectorAll(".tax-info");

  taxSwitch.addEventListener("change", () => {
    taxInfo.forEach((info) => info.classList.toggle("tax-info-visible", taxSwitch.checked));
  });
</script>
